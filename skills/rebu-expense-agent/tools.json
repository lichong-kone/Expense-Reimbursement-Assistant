      "name": "rebu_auth_status",
      "description": "【认证·先调用】检查当前是否已认证（有可用的本地缓存令牌）。未认证时提示需要向用户索取账号密码。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
