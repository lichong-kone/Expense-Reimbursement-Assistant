        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "用户想使用的账号"
          },
          "password": {
            "type": "string",
            "description": "密码（≥6 位）"
          },
          "name": {
            "type": "string",
            "description": "姓名（新注册用；省略则用账号名占位，可后续在 rebu_update_profile 完善）"
          }
        },
        "required": [
          "username",
          "password"
        ]
      }
    },
